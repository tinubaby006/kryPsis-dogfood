// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String
  emailVerified   Boolean  @default(false)
  image           String?
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz
  isPlatformAdmin Boolean  @default(false)
  canCreateEvents Boolean  @default(false)

  sessions              Session[]
  accounts              Account[]
  eventRoles            EventRole[]
  assessmentCredentials AssessmentCredential[]
  createdEvents         Event[]
  createdTeams          Team[]
  teamMemberships       TeamMember[]
  createdInvites        TeamInvite[]
  judgedTracks          JudgeTrack[]
  reviews               Review[]
  uploadedAssets        ProjectAsset[]
  organizerRequests     OrganizerAccessRequest[]
  reviewedRequests      OrganizerAccessRequest[] @relation("ReviewerAdmin")
  proposals             EventProposal[]          @relation("ProposedEvents")
  reviewedProposals     EventProposal[]          @relation("ReviewedProposals")

  judgeAccesses          EventJudgeAccess[]     @relation("JudgeUser")
  invitedJudgeAccesses   EventJudgeAccess[]     @relation("InvitedByAdmin")
  confirmedJudgeAccesses EventJudgeAccess[]     @relation("ConfirmedByAdmin")
  stageJudges            StageJudge[]
  rubricAssignments      RubricAssignment[]
  reviewDrafts           ReviewDraft[]
  judgeCalibrations      JudgeCalibration[]
  finalizationSnapshots  FinalizationSnapshot[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz
  token     String
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz
  refreshTokenExpiresAt DateTime? @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz
  updatedAt             DateTime  @updatedAt @db.Timestamptz

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  @@index([identifier])
  @@map("verification")
}

enum Role {
  PARTICIPANT
  JUDGE
  ORGANIZER
}

model EventRole {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  role      Role
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model AssessmentCredential {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  label     String
  expiresAt DateTime  @db.Timestamptz
  revokedAt DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Visibility {
  DRAFT
  PUBLIC
}

model Event {
  id                 String     @id @default(cuid())
  slug               String     @unique
  name               String
  description        String     @default("")
  startsAt           DateTime?  @db.Timestamptz
  endsAt             DateTime?  @db.Timestamptz
  submissionsOpenAt  DateTime?  @db.Timestamptz
  submissionsCloseAt DateTime   @db.Timestamptz
  timeZone           String     @default("UTC")
  tracksMode         String     @default("SINGLE_POOL")
  visibility         Visibility @default(DRAFT)
  maxTeamSize        Int        @default(4)
  createdById        String
  fixtureSource      String?
  createdAt          DateTime   @default(now()) @db.Timestamptz
  updatedAt          DateTime   @updatedAt @db.Timestamptz

  creator         User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  eventRoles      EventRole[]
  tracks          Track[]
  prizes          Prize[]
  customQuestions CustomQuestion[]
  teams           Team[]
  projects        Project[]
  criteria        Criterion[]
  reviews         Review[]
  judgeAccesses   EventJudgeAccess[]
  judgingStages   JudgingStage[]
  proposal        EventProposal?
}

model Track {
  id          String @id @default(cuid())
  eventId     String
  name        String
  description String @default("")
  sortOrder   Int

  event             Event                   @relation(fields: [eventId], references: [id], onDelete: Restrict)
  judgeTracks       JudgeTrack[]
  projects          Project[]
  judgeAccessTracks EventJudgeAccessTrack[]
  judgingStages     JudgingStage[]

  @@unique([id, eventId])
}

model Prize {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  description String
  amount      Decimal?
  currency    String?
  sortOrder   Int

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
}

enum QuestionType {
  TEXT
  LONG_TEXT
  URL
  NUMBER
  SELECT
  BOOLEAN
}

model CustomQuestion {
  id        String       @id @default(cuid())
  eventId   String
  key       String
  label     String
  type      QuestionType
  required  Boolean      @default(false)
  options   Json?
  isPublic  Boolean      @default(false)
  sortOrder Int

  event   Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  answers CustomAnswer[]

  @@unique([eventId, key])
  @@unique([id, eventId])
}

model Team {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  createdById String
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  event    Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  creator  User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  members  TeamMember[]
  invites  TeamInvite[]
  projects Project[]

  @@unique([id, eventId])
}

enum TeamRole {
  OWNER
  MEMBER
}

model TeamMember {
  id       String   @id @default(cuid())
  eventId  String
  teamId   String
  userId   String
  role     TeamRole
  joinedAt DateTime @default(now()) @db.Timestamptz

  team Team @relation(fields: [teamId, eventId], references: [id, eventId], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@unique([eventId, userId])
}

model TeamInvite {
  id          String    @id @default(cuid())
  eventId     String
  teamId      String
  tokenHash   String    @unique
  createdById String
  expiresAt   DateTime  @db.Timestamptz
  revokedAt   DateTime? @db.Timestamptz
  maxUses     Int
  uses        Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz

  team    Team @relation(fields: [teamId, eventId], references: [id, eventId], onDelete: Restrict)
  creator User @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model JudgeTrack {
  eventId String
  userId  String
  trackId String

  track Track @relation(fields: [trackId, eventId], references: [id, eventId], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId, trackId])
}

enum ProjectStatus {
  DRAFT
  SUBMITTED
}

enum RecordSource {
  LIVE
  FIXTURE
}

model Project {
  id            String        @id @default(cuid())
  eventId       String
  teamId        String
  trackId       String?
  title         String        @default("")
  summary       String        @default("")
  description   String        @default("")
  repoUrl       String?
  liveUrl       String?
  demoVideoUrl  String?
  techTags      String[]      @default([])
  status        ProjectStatus
  submittedAt   DateTime?     @db.Timestamptz
  version       Int           @default(1)
  duplicateOfId String?
  source        RecordSource
  createdAt     DateTime      @default(now()) @db.Timestamptz
  updatedAt     DateTime      @updatedAt @db.Timestamptz

  event             Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  team              Team               @relation(fields: [teamId, eventId], references: [id, eventId], onDelete: Restrict)
  track             Track?             @relation(fields: [trackId, eventId], references: [id, eventId], onDelete: Restrict)
  assets            ProjectAsset[]
  answers           CustomAnswer[]
  reviews           Review[]
  stageProjects     StageProject[]
  rubricAssignments RubricAssignment[]
  projectResults    ProjectResult[]

  @@unique([id, eventId])
}

enum AssetKind {
  THUMBNAIL
  GALLERY
}

model ProjectAsset {
  id           String    @id @default(cuid())
  eventId      String
  projectId    String
  kind         AssetKind
  storageKey   String    @unique
  originalName String
  mimeType     String
  bytes        Int
  sortOrder    Int
  createdById  String
  createdAt    DateTime  @default(now()) @db.Timestamptz

  project Project @relation(fields: [projectId, eventId], references: [id, eventId], onDelete: Cascade)
  creator User    @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model CustomAnswer {
  projectId  String
  questionId String
  eventId    String
  value      Json

  project  Project        @relation(fields: [projectId, eventId], references: [id, eventId], onDelete: Cascade)
  question CustomQuestion @relation(fields: [questionId, eventId], references: [id, eventId], onDelete: Restrict)

  @@id([projectId, questionId])
}

model AuditLog {
  id          String   @id @default(cuid())
  eventId     String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json
  createdAt   DateTime @default(now()) @db.Timestamptz
}

model Criterion {
  id        String   @id @default(cuid())
  eventId   String
  key       String
  label     String
  weight    Decimal?
  minScore  Decimal?
  maxScore  Decimal?
  sortOrder Int

  event  Event            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  scores CriterionScore[]

  @@unique([eventId, key])
  @@unique([id, eventId])
}

model Review {
  id          String       @id @default(cuid())
  eventId     String
  judgeUserId String
  projectId   String
  comment     String       @default("")
  source      RecordSource
  createdAt   DateTime     @default(now()) @db.Timestamptz
  updatedAt   DateTime     @updatedAt @db.Timestamptz

  event   Event            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  project Project          @relation(fields: [projectId, eventId], references: [id, eventId], onDelete: Cascade)
  judge   User             @relation(fields: [judgeUserId], references: [id], onDelete: Restrict)
  scores  CriterionScore[]

  @@unique([eventId, judgeUserId, projectId])
  @@unique([id, eventId])
}

model CriterionScore {
  reviewId    String
  criterionId String
  eventId     String
  value       Decimal

  review    Review    @relation(fields: [reviewId, eventId], references: [id, eventId], onDelete: Cascade)
  criterion Criterion @relation(fields: [criterionId, eventId], references: [id, eventId], onDelete: Restrict)

  @@id([reviewId, criterionId])
}

model FixtureImport {
  id           String        @id @default(cuid())
  sourceName   String
  sourceSha256 String
  importedAt   DateTime      @default(now()) @db.Timestamptz
  counts       Json
  rawPayload   Json
  issues       ImportIssue[]

  @@unique([sourceName, sourceSha256])
}

model ImportIssue {
  id         String   @id @default(cuid())
  importId   String
  severity   String
  code       String
  entityType String
  entityId   String?
  details    Json
  createdAt  DateTime @default(now()) @db.Timestamptz

  import FixtureImport @relation(fields: [importId], references: [id], onDelete: Cascade)
}

enum OrganizerAccessStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  REVOKED
}

model OrganizerAccessRequest {
  id                String                @id @default(cuid())
  applicantUserId   String
  applicant         User                  @relation(fields: [applicantUserId], references: [id], onDelete: Cascade)
  organizationName  String?
  proposedEventName String
  reason            String                @db.Text
  websiteUrl        String?
  status            OrganizerAccessStatus @default(PENDING)
  reviewedById      String?
  reviewedBy        User?                 @relation("ReviewerAdmin", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?             @db.Timestamptz
  decisionReason    String?               @db.Text
  createdAt         DateTime              @default(now()) @db.Timestamptz
  updatedAt         DateTime              @updatedAt @db.Timestamptz
  version           Int                   @default(1)

  @@index([status, createdAt])
  @@index([applicantUserId, createdAt])
}

enum EventProposalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  WITHDRAWN
}

model EventProposal {
  id                 String              @id @default(cuid())
  applicantUserId    String
  name               String
  proposedSlug       String
  description        String              @default("")
  timeZone           String              @default("UTC")
  tracksMode         String              @default("SINGLE_POOL")
  startsAt           DateTime?           @db.Timestamptz
  endsAt             DateTime?           @db.Timestamptz
  submissionsOpenAt  DateTime?           @db.Timestamptz
  submissionsCloseAt DateTime            @db.Timestamptz
  maxTeamSize        Int                 @default(4)
  status             EventProposalStatus @default(DRAFT)
  revision           Int                 @default(1)
  
  submittedAt        DateTime?           @db.Timestamptz
  reviewedAt         DateTime?           @db.Timestamptz
  reviewedById       String?
  decisionReason     String?             @db.Text
  approvedEventId    String?             @unique

  createdAt          DateTime            @default(now()) @db.Timestamptz
  updatedAt          DateTime            @updatedAt @db.Timestamptz

  applicant          User                @relation("ProposedEvents", fields: [applicantUserId], references: [id], onDelete: Cascade)
  reviewer           User?               @relation("ReviewedProposals", fields: [reviewedById], references: [id])
  approvedEvent      Event?              @relation(fields: [approvedEventId], references: [id])
}

enum EventJudgeAccessStatus {
  INVITED
  AWAITING_CONFIRMATION
  ACTIVE
  REVOKED
  EXPIRED
}

model EventJudgeAccess {
  id              String                 @id @default(cuid())
  eventId         String
  emailNormalized String
  userId          String?
  status          EventJudgeAccessStatus
  tokenHash       String?                @unique
  invitedById     String
  confirmedById   String?
  expiresAt       DateTime?              @db.Timestamptz
  acceptedAt      DateTime?              @db.Timestamptz
  confirmedAt     DateTime?              @db.Timestamptz
  revokedAt       DateTime?              @db.Timestamptz
  createdAt       DateTime               @default(now()) @db.Timestamptz
  updatedAt       DateTime               @updatedAt @db.Timestamptz
  version         Int                    @default(1)

  event       Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User? @relation("JudgeUser", fields: [userId], references: [id], onDelete: SetNull)
  invitedBy   User  @relation("InvitedByAdmin", fields: [invitedById], references: [id])
  confirmedBy User? @relation("ConfirmedByAdmin", fields: [confirmedById], references: [id])

  tracks EventJudgeAccessTrack[]

  @@unique([eventId, emailNormalized])
  @@unique([id, eventId])
  @@index([eventId, status])
}

model EventJudgeAccessTrack {
  accessId String
  eventId  String
  trackId  String

  access EventJudgeAccess @relation(fields: [accessId, eventId], references: [id, eventId], onDelete: Cascade)
  track  Track            @relation(fields: [trackId, eventId], references: [id, eventId], onDelete: Cascade)

  @@id([accessId, trackId])
}

enum StageState {
  DRAFT
  CONFIGURED
  ASSIGNING
  OPEN
  CLOSED
  CALCULATING
  CALCULATED
  FINALIZED
}

enum StageScope {
  EVENT
  TRACK
  OVERALL
}

model JudgingStage {
  id              String     @id @default(cuid())
  eventId         String
  name            String
  state           StageState @default(DRAFT)
  method          String     @default("RUBRIC")
  scope           StageScope @default(EVENT)
  scopeKey        String
  trackId         String?
  requiredReviews Int        @default(1)
  algorithmVer    String?
  configHash      String?
  outputPolicy    Json?
  startsAt        DateTime?  @db.Timestamptz
  endsAt          DateTime?  @db.Timestamptz
  createdAt       DateTime   @default(now()) @db.Timestamptz
  updatedAt       DateTime   @updatedAt @db.Timestamptz

  event Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  track Track? @relation(fields: [trackId, eventId], references: [id, eventId], onDelete: Restrict)

  assignments     RubricAssignment[]
  rubrics         RubricVersion[]
  projects        StageProject[]
  judges          StageJudge[]
  assignmentRuns  AssignmentRun[]
  calculationRuns CalculationRun[]
  auditEvents     AuditEvent[]
  finalizations   FinalizationSnapshot[]

  @@unique([eventId, name])
}

model StageProject {
  id              String   @id @default(cuid())
  stageId         String
  projectId       String
  eventId         String
  versionSnapshot Int
  eligibility     String?
  createdAt       DateTime @default(now()) @db.Timestamptz

  stage   JudgingStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId, eventId], references: [id, eventId], onDelete: Restrict)

  @@unique([stageId, projectId])
}

model StageJudge {
  id          String   @id @default(cuid())
  stageId     String
  judgeUserId String
  isActive    Boolean  @default(true)
  capacity    Int?
  eligibility String?
  createdAt   DateTime @default(now()) @db.Timestamptz

  stage JudgingStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  judge User         @relation(fields: [judgeUserId], references: [id], onDelete: Restrict)

  @@unique([stageId, judgeUserId])
}

model RubricVersion {
  id          String   @id @default(cuid())
  stageId     String
  versionHash String
  createdAt   DateTime @default(now()) @db.Timestamptz

  stage    JudgingStage      @relation(fields: [stageId], references: [id], onDelete: Cascade)
  criteria RubricCriterion[]
  reviews  StageReview[]
}

model RubricCriterion {
  id              String  @id @default(cuid())
  rubricVersionId String
  key             String
  title           String
  helpText        String?
  weightBasisPts  Int
  maxScore        Int
  minScore        Int     @default(0)
  sortOrder       Int

  rubricVersion RubricVersion         @relation(fields: [rubricVersionId], references: [id], onDelete: Cascade)
  scores        StageCriterionScore[]

  @@unique([rubricVersionId, key])
}

model AssignmentRun {
  id          String   @id @default(cuid())
  stageId     String
  version     Int
  seed        String?
  configHash  String
  inputHash   String
  actorUserId String?
  reason      String?
  diagnostics Json?
  createdAt   DateTime @default(now()) @db.Timestamptz

  stage       JudgingStage       @relation(fields: [stageId], references: [id], onDelete: Cascade)
  assignments RubricAssignment[]

  @@unique([stageId, version])
}

model RubricAssignment {
  id          String   @id @default(cuid())
  stageId     String
  projectId   String
  judgeUserId String
  runId       String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now()) @db.Timestamptz

  stage   JudgingStage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  project Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  judge   User          @relation(fields: [judgeUserId], references: [id], onDelete: Restrict)
  run     AssignmentRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  reviewDraft ReviewDraft?
  finalReview StageReview?

  @@unique([stageId, projectId, judgeUserId])
}

model ReviewDraft {
  id           String   @id @default(cuid())
  assignmentId String   @unique
  judgeUserId  String
  scores       Json
  comment      String?
  revision     Int      @default(1)
  updatedAt    DateTime @updatedAt @db.Timestamptz

  assignment RubricAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  judge      User             @relation(fields: [judgeUserId], references: [id], onDelete: Restrict)
}

model StageReview {
  id              String   @id @default(cuid())
  assignmentId    String   @unique
  rubricVersionId String
  comment         String?
  submittedAt     DateTime @default(now()) @db.Timestamptz

  assignment    RubricAssignment      @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  rubricVersion RubricVersion         @relation(fields: [rubricVersionId], references: [id], onDelete: Restrict)
  scores        StageCriterionScore[]
}

model StageCriterionScore {
  reviewId    String
  criterionId String
  value       Int

  review    StageReview     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  criterion RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  @@id([reviewId, criterionId])
}

model CalculationRun {
  id          String    @id @default(cuid())
  stageId     String
  method      String
  configHash  String
  inputHash   String
  implVersion String
  status      String    @default("PENDING")
  diagnostics Json?
  startedAt   DateTime  @default(now()) @db.Timestamptz
  finishedAt  DateTime? @db.Timestamptz

  stage          JudgingStage           @relation(fields: [stageId], references: [id], onDelete: Cascade)
  projectResults ProjectResult[]
  calibrations   JudgeCalibration[]
  snapshots      FinalizationSnapshot[]

  @@unique([stageId, configHash, inputHash])
}

model JudgeCalibration {
  id               String @id @default(cuid())
  calculationRunId String
  judgeUserId      String
  offset           Float
  reviewCount      Int
  diagnostics      Json?

  calculationRun CalculationRun @relation(fields: [calculationRunId], references: [id], onDelete: Cascade)
  judge          User           @relation(fields: [judgeUserId], references: [id], onDelete: Restrict)

  @@unique([calculationRunId, judgeUserId])
}

model ProjectResult {
  id               String  @id @default(cuid())
  calculationRunId String
  projectId        String
  reviewCount      Int
  rawMean          Float
  normalizedMean   Float
  displayedMean    Float
  sd               Float?
  rank             Int?
  tieKey           String?

  calculationRun CalculationRun @relation(fields: [calculationRunId], references: [id], onDelete: Cascade)
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([calculationRunId, projectId])
}

model FinalizationSnapshot {
  id               String   @id @default(cuid())
  stageId          String
  calculationRunId String
  canonicalHash    String
  finalizedById    String
  snapshotData     Json
  finalizedAt      DateTime @default(now()) @db.Timestamptz

  stage          JudgingStage   @relation(fields: [stageId], references: [id], onDelete: Restrict)
  calculationRun CalculationRun @relation(fields: [calculationRunId], references: [id], onDelete: Restrict)
  finalizedBy    User           @relation(fields: [finalizedById], references: [id], onDelete: Restrict)
}

model AuditEvent {
  id          String   @id @default(cuid())
  stageId     String?
  eventId     String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  reason      String?
  metadata    Json
  createdAt   DateTime @default(now()) @db.Timestamptz

  stage JudgingStage? @relation(fields: [stageId], references: [id], onDelete: Restrict)
}
